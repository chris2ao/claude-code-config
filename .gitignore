# Ignore everything by default
*

# ===== TRACK THESE =====
!.gitignore
!README.md
!COMPLETE-GUIDE.md

# Rules (organized in subdirectories: core/, development/, operations/)
!rules/
!rules/**

# Custom agents
!agents/
!agents/*.md

# Skills (custom SKILL.md + learned patterns)
!skills/
!skills/**

# Custom commands
!commands/
!commands/*.md

# Scripts (cleanup, automation)
# NOTE: this file is allowlist-style (line 2 is `*`), so it fails CLOSED on any new
# extension. A script added with an unlisted extension is silently untracked and never
# syncs. Add the extension here when introducing one. Verify with:
#   git check-ignore -v scripts/<file>
!scripts/
!scripts/*.sh
!scripts/*.py
# Data files that scripts/skills depend on at runtime (device-signatures.yml is read by
# homenet-device-profile; wrap-up-exclude.txt is read by wrap-up).
!scripts/*.yml
!scripts/*.txt

# Hooks (PreToolUse, PostToolUse, Stop, SessionEnd)
!hooks/
!hooks/**

# MCP server configurations and custom servers
!mcp-servers/
!mcp-servers/**

# Templates (config file templates for new machine setup)
!templates/
!templates/**

# Documentation
!docs/
!docs/**

# Homunculus (instincts, evolved artifacts, identity template)
!homunculus/
!homunculus/**

# ===== NEVER TRACK (even if whitelisted above) =====
cache/
plugins/cache/
sessions/
history.jsonl
settings.json
projects/
file-history/
shell-snapshots/
todos/
tasks/
plans/
downloads/
debug/
ide/
session-env/
node_modules/
*.backup
observations.jsonl
